# ==========================================================
# Ephphatha Concepts — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ==========================================================

# --- App ---
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/ephphathaConcepts?retryWrites=true&w=majority

# --- Session / Security ---
SESSION_SECRET=change_this_to_a_long_random_string_at_least_32_chars
COOKIE_SECURE=false
# Set COOKIE_SECURE=true in production (requires HTTPS)

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Resend (contact form email) ---
RESEND_API_KEY=your_resend_api_key
CONTACT_TO_EMAIL=ephphatha247@gmail.com
CONTACT_FROM_EMAIL=no-reply@ephphathaconcepts.com

# --- WhatsApp (digits only, country code, no + or spaces) ---
WHATSAPP_NUMBER=2348032157437

# --- Admin default account ---
# Used ONLY once by seed/seedAdmin.js to create the first admin account.
# Rotate/remove these values from .env immediately after the first successful login.
ADMIN_DEFAULT_EMAIL=Admin@onexportalhq.com
ADMIN_DEFAULT_PASSWORD=OneXptest@onexportalhqlogindashboard210

# --- Developer / Brand attribution (rendered in footer partial) ---
DEVELOPER_NAME=Amos Isaiah Tizhe
DEVELOPER_URL=https://founder.onexportalhq.com/
DEVELOPER_BRAND=OneXportal
BRAND_URL=https://onexportalhq.com/about-onexportal
